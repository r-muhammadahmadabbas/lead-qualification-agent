# LLM provider (optional). Without a key the agent uses a deterministic
# template for the draft response, so the full workflow still runs offline.
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
LLM_TEMPERATURE=0.3

# Lead scoring thresholds
HIGH_QUALIFICATION_SCORE=5
MEDIUM_QUALIFICATION_SCORE=3

# Paths (optional overrides)
# COMPANIES_PATH=./data/companies.json
# LOG_DIR=./logs
